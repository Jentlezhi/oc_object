  pod 'YYComponents/UIKit', :git => 'https://git.zuche.com/jt.zhi/yycomponents.git',:commit => '8b9a850'
  pod 'YYComponents/Format/NumberFormat', :git => 'https://git.zuche.com/jt.zhi/yycomponents.git',:commit => '8b9a850'
